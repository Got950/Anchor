# Copy to backend/.env. Without a key the system still runs end to end, but every LLM
# call falls back to a deterministic heuristic (see app/llm.py) and RAGAS is skipped.
OPENAI_API_KEY=sk-...
CRAFTIFY_LLM_MODEL=gpt-4.1-mini
CRAFTIFY_JUDGE_MODEL=gpt-4.1-mini

# Optional: point the same OpenAI-compatible client at Groq / Gemini instead.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Optional threshold overrides (defaults in app/config.py).
# CRAFTIFY_ABSTAIN_THRESHOLD=0.0155
# CRAFTIFY_DENSE_MAX_DISTANCE=0.75
# CRAFTIFY_BM25_MAX_DF_RATIO=0.2
